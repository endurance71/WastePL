{
  "name": "@wastepl/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "readiness:production-api": "tsx src/readiness/production-api-gate-100.ts",
    "readiness:sianow-pszok-api": "tsx src/readiness/sianow-pszok-api-post-gate.ts",
    "readiness:tychowo-pszok-api": "tsx src/readiness/tychowo-pszok-api-post-gate.ts",
    "readiness:polanow-garbno-api": "tsx src/readiness/polanow-garbno-api-post-gate.ts",
    "readiness:bedzino-dworek-api": "tsx src/readiness/bedzino-dworek-api-post-gate.ts",
    "readiness:sianow-grabowko-api": "tsx src/readiness/sianow-grabowko-api-post-gate.ts",
    "readiness:swieszyno-chalupy-api": "tsx src/readiness/swieszyno-chalupy-api-post-gate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@wastepl/domain": "workspace:*",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
