{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wastepl.pl/schemas/wastepl-facility-v0.2.schema.json",
  "title": "WastePL Facility Contract v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "key",
    "kind",
    "name",
    "address",
    "location",
    "locationSourceKey",
    "externalIds",
    "acceptedMaterials",
    "acceptedContainers",
    "openingHours",
    "access",
    "operationalStatus",
    "sourceKey",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.2.0" },
    "key": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "PSZOK",
        "DEPOSIT_RVM",
        "DEPOSIT_MANUAL",
        "ELECTRONICS",
        "TEXTILES",
        "BATTERIES",
        "MEDICINES",
        "OTHER"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "address": { "type": ["string", "null"] },
    "location": {
      "oneOf": [
        { "$ref": "#/$defs/geoPoint" },
        { "type": "null" }
      ]
    },
    "locationSourceKey": { "type": ["string", "null"] },
    "externalIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalId" }
    },
    "acceptedMaterials": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/facilityMaterial" }
    },
    "acceptedContainers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/depositContainer" }
    },
    "openingHours": {
      "oneOf": [
        { "$ref": "#/$defs/openingHours" },
        { "type": "null" }
      ]
    },
    "access": { "$ref": "#/$defs/accessRule" },
    "operationalStatus": { "$ref": "#/$defs/operationalStatus" },
    "operatorName": { "type": ["string", "null"] },
    "rulesUrl": { "type": ["string", "null"], "format": "uri" },
    "sourceKey": { "type": "string", "minLength": 1 },
    "quality": { "$ref": "#/$defs/quality" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "PSZOK" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "acceptedContainers": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "enum": ["DEPOSIT_RVM", "DEPOSIT_MANUAL"] }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": { "acceptedContainers": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "location": { "type": "object" } },
        "required": ["location"]
      },
      "then": {
        "properties": {
          "locationSourceKey": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "isoDate": { "type": "string", "format": "date" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "hhmm": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationStatus",
        "confidence",
        "retrievedAt",
        "warnings"
      ],
      "properties": {
        "verificationStatus": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "OFFICIAL_SOURCE",
            "UNVERIFIED",
            "REVIEW_REQUIRED"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "retrievedAt": { "$ref": "#/$defs/isoDateTime" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "externalId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "facilityMaterial": {
      "type": "string",
      "enum": [
        "MIXED",
        "BIO",
        "PAPER",
        "GLASS",
        "METALS_PLASTICS",
        "GREEN",
        "BULKY",
        "ASH",
        "TEXTILES",
        "ELECTRONICS",
        "BATTERIES",
        "MEDICINES",
        "CONSTRUCTION",
        "RUBBLE",
        "TYRES",
        "HAZARDOUS",
        "OTHER"
      ]
    },
    "depositContainer": {
      "type": "string",
      "enum": ["PET_BOTTLE", "METAL_CAN", "REUSABLE_GLASS_BOTTLE"]
    },
    "openingInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens", "closes"],
      "properties": {
        "opens": { "$ref": "#/$defs/hhmm" },
        "closes": { "$ref": "#/$defs/hhmm" }
      }
    },
    "weeklyHours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "intervals"],
      "properties": {
        "day": {
          "type": "string",
          "enum": [
            "MONDAY",
            "TUESDAY",
            "WEDNESDAY",
            "THURSDAY",
            "FRIDAY",
            "SATURDAY",
            "SUNDAY"
          ]
        },
        "intervals": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingInterval" }
        }
      }
    },
    "hoursException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "status", "intervals"],
      "properties": {
        "date": { "$ref": "#/$defs/isoDate" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "intervals": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingInterval" }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "openingHours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "weekly", "exceptions", "sourceKey"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "weekly": {
          "type": "array",
          "items": { "$ref": "#/$defs/weeklyHours" }
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/hoursException" }
        },
        "sourceKey": { "type": "string", "minLength": 1 }
      }
    },
    "accessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "requiresProof",
        "quantityLimits",
        "notes",
        "sourceKey"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "OPEN_TO_ALL",
            "MUNICIPALITY_RESIDENTS",
            "MUNICIPALITY_PROPERTY_OWNERS",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "requiresProof": { "type": ["boolean", "null"] },
        "quantityLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material", "limit", "period"],
            "properties": {
              "material": { "type": "string", "minLength": 1 },
              "limit": { "type": "string", "minLength": 1 },
              "period": { "type": ["string", "null"] }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sourceKey": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "scope": { "not": { "const": "UNKNOWN" } } },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "sourceKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "operationalStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observedAt", "sourceKey", "note"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["OPERATIONAL", "TEMPORARILY_UNAVAILABLE", "UNKNOWN"]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "sourceKey": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["OPERATIONAL", "TEMPORARILY_UNAVAILABLE"]
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "observedAt": { "type": "string", "format": "date-time" },
              "sourceKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}