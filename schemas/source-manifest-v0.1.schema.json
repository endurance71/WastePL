{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wastepl.pl/schemas/source-manifest-v0.1.schema.json",
  "title": "WastePL source manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "version", "generatedAt", "municipalities"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "manifestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "municipalities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/municipality" }
    }
  },
  "$defs": {
    "municipality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terc", "name", "sources"],
      "properties": {
        "terc": { "type": "string", "pattern": "^[0-9]{7}$" },
        "name": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "role", "requiredRoles", "freshnessMinutes"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "requiredRoles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
        },
        "freshnessMinutes": { "type": "integer", "minimum": 60, "maximum": 10080 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "evidenceStatus", "activationBlocker", "assessedAt", "childArtifactUrls", "notes"],
      "properties": {
        "shape": {
          "enum": [
            "DIRECT_CONTENT",
            "ATTACHMENT_INDEX",
            "MULTI_ROUTE_PDF_SET",
            "IMAGE_ONLY_OR_OCR_REQUIRED",
            "MIXED_MEDIA",
            "UNSUPPORTED_OR_AMBIGUOUS"
          ]
        },
        "evidenceStatus": { "enum": ["VERIFIED", "PARTIAL", "MISSING"] },
        "activationBlocker": { "type": ["string", "null"] },
        "assessedAt": { "type": "string", "format": "date-time" },
        "childArtifactUrls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "dataType", "url", "format", "status", "parserKey", "pollIntervalMinutes", "ownerType", "ownerName", "reuseNotes", "activeFrom", "activeTo"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "dataType": { "enum": ["COLLECTION_SCHEDULE", "PSZOK", "ALERTS", "OTHER"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "format": { "enum": ["PDF_TEXT", "HTML", "PDF", "JSON", "CSV", "XLSX", "GML", "OTHER"] },
        "status": { "enum": ["ACTIVE", "PLANNED"] },
        "parserKey": { "type": ["string", "null"] },
        "pollIntervalMinutes": { "type": "integer", "minimum": 60, "maximum": 10080 },
        "ownerType": { "enum": ["MUNICIPALITY", "MUNICIPAL_COMPANY", "BIP", "OTHER_OFFICIAL"] },
        "ownerName": { "type": "string", "minLength": 1 },
        "reuseNotes": { "type": "string", "minLength": 1 },
        "activeFrom": { "type": ["string", "null"], "format": "date" },
        "activeTo": { "type": ["string", "null"], "format": "date" },
        "bundle": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/bundle" }
          ]
        },
        "assessment": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/assessment" }
          ]
        }
      }
    }
  }
}
