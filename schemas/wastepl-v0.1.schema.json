{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wastepl.pl/schemas/wastepl-v0.1.schema.json",
  "title": "WastePL Normalized Dataset v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "municipality", "serviceAreas", "collectionEvents", "sources"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "municipality": {"$ref": "#/$defs/municipality"},
    "serviceAreas": {"type": "array", "items": {"$ref": "#/$defs/serviceArea"}},
    "collectionEvents": {"type": "array", "items": {"$ref": "#/$defs/collectionEvent"}},
    "facilities": {"type": "array", "default": [], "items": {"$ref": "#/$defs/facility"}},
    "alerts": {"type": "array", "default": [], "items": {"$ref": "#/$defs/alert"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "isoDate": {"type": "string", "format": "date"},
    "isoDateTime": {"type": "string", "format": "date-time"},
    "verificationStatus": {"type": "string", "enum": ["VERIFIED", "OFFICIAL_SOURCE", "UNVERIFIED", "REVIEW_REQUIRED"]},
    "municipality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terc", "name"],
      "properties": {
        "terc": {"type": "string", "minLength": 4, "maxLength": 10},
        "name": {"type": "string", "minLength": 1},
        "municipalityType": {"type": ["string", "null"], "enum": ["URBAN", "RURAL", "URBAN_RURAL", "DISTRICT_CITY", "OTHER", null]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verificationStatus", "confidence", "retrievedAt"],
      "properties": {
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "retrievedAt": {"$ref": "#/$defs/isoDateTime"},
        "warnings": {"type": "array", "default": [], "items": {"type": "string"}}
      }
    },
    "coverageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "priority"],
      "properties": {
        "type": {"type": "string", "enum": ["MUNICIPALITY", "LOCALITY", "STREET", "NUMBER_RANGE", "EXPLICIT_NUMBERS", "EXPLICIT_ADDRESS", "EXCLUDE"]},
        "priority": {"type": "integer", "minimum": 0},
        "simc": {"type": ["string", "null"]},
        "ulic": {"type": ["string", "null"]},
        "numberFrom": {"type": ["integer", "null"], "minimum": 1},
        "numberTo": {"type": ["integer", "null"], "minimum": 1},
        "parity": {"type": ["string", "null"], "enum": ["ALL", "ODD", "EVEN", null]},
        "explicitNumbers": {"type": "array", "default": [], "items": {"type": "string"}},
        "explicitAddress": {"type": ["string", "null"]}
      }
    },
    "serviceArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "coverage"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "buildingType": {"type": ["string", "null"], "enum": ["SINGLE_FAMILY", "MULTI_FAMILY", "MIXED", "OTHER", null]},
        "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverageRule"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "url", "ownerType", "format", "artifact"],
      "properties": {
        "sourceKey": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "ownerType": {"type": "string", "enum": ["MUNICIPALITY", "MUNICIPAL_COMPANY", "WASTE_OPERATOR", "DEPOSIT_OPERATOR", "OTHER_PUBLIC", "OTHER"]},
        "format": {"type": "string", "enum": ["API", "JSON", "CSV", "XLSX", "HTML", "PDF_TEXT", "PDF_SCAN", "IMAGE", "ICS", "OTHER"]},
        "reuseBasis": {"type": ["string", "null"]},
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "retrievedAt", "parserKey", "parserVersion"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
            "retrievedAt": {"$ref": "#/$defs/isoDateTime"},
            "parserKey": {"type": "string", "minLength": 1},
            "parserVersion": {"type": "string", "minLength": 1},
            "extractionConfidence": {"type": "number", "minimum": 0, "maximum": 1},
            "storageUri": {"type": ["string", "null"]}
          }
        }
      }
    },
    "collectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceAreaKey", "fraction", "date", "status", "sourceKey", "quality"],
      "properties": {
        "serviceAreaKey": {"type": "string", "minLength": 1},
        "fraction": {"type": "string", "enum": ["MIXED", "BIO", "PAPER", "GLASS", "METALS_PLASTICS", "GREEN", "BULKY", "ASH", "TEXTILES", "OTHER"]},
        "date": {"$ref": "#/$defs/isoDate"},
        "status": {"type": "string", "enum": ["SCHEDULED", "CHANGED", "CANCELLED", "COMPLETED"]},
        "note": {"type": ["string", "null"]},
        "sourceKey": {"type": "string", "minLength": 1},
        "quality": {"$ref": "#/$defs/quality"}
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "name", "location", "sourceKey", "quality"],
      "properties": {
        "key": {"type": "string"},
        "kind": {"type": "string", "enum": ["PSZOK", "DEPOSIT_RVM", "DEPOSIT_MANUAL", "ELECTRONICS", "TEXTILES", "BATTERIES", "MEDICINES", "OTHER"]},
        "name": {"type": "string"},
        "address": {"type": ["string", "null"]},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": {
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lon": {"type": "number", "minimum": -180, "maximum": 180}
          }
        },
        "sourceKey": {"type": "string"},
        "quality": {"$ref": "#/$defs/quality"}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "body", "startsAt", "sourceKey", "quality"],
      "properties": {
        "type": {"type": "string", "enum": ["SCHEDULE_CHANGE", "DELAY", "CANCELLATION", "FACILITY_CLOSURE", "SERVICE_NOTICE", "OTHER"]},
        "title": {"type": "string"},
        "body": {"type": "string"},
        "startsAt": {"$ref": "#/$defs/isoDateTime"},
        "sourceKey": {"type": "string"},
        "quality": {"$ref": "#/$defs/quality"}
      }
    }
  }
}
